# Reddit application-only OAuth. Copy the two exports into your shell, or let
# scripts/reddit_client.py fall back to the 1Password references below.
#
# The app is a "script"-type app registered at
# https://www.reddit.com/prefs/apps — only the client id and secret are used;
# no account password is involved in the client_credentials flow.

export REDDIT_CLIENT_ID="$(op read 'op://Daniel - Personal/Reddit Oauth For N8N/Client ID')"
export REDDIT_CLIENT_SECRET="$(op read 'op://Daniel - Personal/Reddit Oauth For N8N/Secret')"
